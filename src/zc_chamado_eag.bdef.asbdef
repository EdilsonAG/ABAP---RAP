projection;
strict ( 2 );
use draft;

define behavior for ZC_CHAMADO_EAG alias Chamado
use etag
{
  use create;
  use update;
  use delete;

  use action fechar;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

  use association _Comentarios { create; with draft; }
}


define behavior for ZC_COMENTARIO_EAG alias Comentario
use etag
{
  use update;
  use delete;

  use association _Chamado { with draft; }
}